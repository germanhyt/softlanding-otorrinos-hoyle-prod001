---
import { congresos, logos } from "@content/content";
import MotionReveal from "@components/islands/MotionReveal";
---

<section
  id={congresos.id}
  class="congresos bg-[#F4F3FA] py-12 md:py-14 lg:py-16"
  aria-labelledby="congresos-heading"
>
  <div class="container">
    <MotionReveal client:load variant="up" className="mx-auto max-w-3xl text-center">
      <h2
        id="congresos-heading"
        class="font-serif text-[1.85rem] font-medium leading-[1.15] text-[#211E46] sm:text-[2.35rem] md:text-[2.75rem]"
      >
        {congresos.headline}
      </h2>
      <p class="mx-auto mt-3 max-w-2xl font-dm text-sm text-[#3d4268] sm:text-base">
        {congresos.intro}
      </p>
    </MotionReveal>

    <MotionReveal client:load variant="scale" delay={0.15} className="mt-8 sm:mt-10">
      <div class="congresos-grid">
        {
          congresos.photos.map((photo) => (
            <figure class:list={["congresos-cell", `is-${photo.area}`]}>
              <img
                src={photo.src}
                alt={photo.alt}
                width="720"
                height="560"
                loading="lazy"
                decoding="async"
              />
              <figcaption>{photo.caption}</figcaption>
            </figure>
          ))
        }

        <div class="congresos-logo is-logo">
          <img src={logos.white.src} alt={logos.white.alt} width="220" height="48" />
        </div>

        <article class="congresos-note is-note">
          <h3>{congresos.experience.title}</h3>
          <p>{congresos.experience.body}</p>
        </article>
      </div>
    </MotionReveal>
  </div>
</section>

<style>
  .congresos-grid {
    display: grid;
    gap: 0.75rem;
  }

  .congresos-cell,
  .congresos-logo,
  .congresos-note {
    position: relative;
    overflow: hidden;
    border-radius: 1.15rem;
    min-height: 12rem;
  }

  .congresos-cell img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .congresos-cell::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 46%;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgb(8 14 48 / 0.28) 42%,
      rgb(6 12 42 / 0.72) 100%
    );
    pointer-events: none;
  }

  .congresos-cell figcaption {
    position: absolute;
    left: 50%;
    bottom: 0.85rem;
    z-index: 1;
    width: max-content;
    max-width: calc(100% - 1.5rem);
    transform: translateX(-50%);
    border-radius: 0.45rem;
    background: #fff;
    padding: 0.4rem 0.7rem;
    font-size: 0.68rem;
    line-height: 1.3;
    color: #211e46;
    text-align: center;
  }

  .congresos-logo,
  .congresos-note {
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #141246;
    color: #fff;
  }

  .congresos-logo {
    align-items: center;
    min-height: 8rem;
    padding: 1.5rem;
  }

  .congresos-logo img {
    width: min(100%, 11rem);
    height: auto;
  }

  .congresos-note {
    padding: 1.5rem 1.35rem;
  }

  .congresos-note h3 {
    font-family: "Roboto Serif", Georgia, serif;
    font-size: 1.65rem;
    font-weight: 500;
    line-height: 1.15;
  }

  .congresos-note p {
    margin-top: 0.85rem;
    font-size: 0.92rem;
    line-height: 1.45;
    color: rgb(255 255 255 / 0.88);
  }

  @media (min-width: 900px) {
    .congresos-grid {
      grid-template-columns: 1.15fr 0.9fr 1fr;
      grid-template-rows: 15rem 9.5rem 13rem;
      gap: 0.85rem;
      grid-template-areas:
        "a b b"
        "c logo e"
        "note d e";
    }

    .congresos-cell,
    .congresos-logo,
    .congresos-note {
      min-height: 0;
      height: 100%;
      border-radius: 1.35rem;
    }

    .is-a { grid-area: a; }
    .is-b { grid-area: b; }
    .is-c { grid-area: c; }
    .is-logo { grid-area: logo; }
    .is-note { grid-area: note; }
    .is-d { grid-area: d; }
    .is-e { grid-area: e; }

    .congresos-note h3 {
      font-size: 1.85rem;
    }
  }

  @media (min-width: 1280px) {
    .congresos-grid {
      grid-template-rows: 18rem 12rem 16.5rem;
      gap: 1rem;
    }
  }

  @media (min-width: 1536px) {
    .congresos-grid {
      grid-template-rows: 22rem 14.5rem 20rem;
    }
  }

  @media (min-width: 1800px) {
    .congresos-grid {
      grid-template-rows: 26rem 17rem 23.5rem;
    }
  }
</style>
