---
import { siteConfig } from "@config/site.config";
import { contacto } from "@content/content";
import MotionReveal from "@components/islands/MotionReveal";
import ContactForm from "@components/islands/ContactForm";
---

<section
  id={contacto.id}
  class="contacto bg-brand-neutral-mist py-10 md:py-12 lg:py-14"
  aria-labelledby="contacto-heading"
>
  <div class="container">
    <MotionReveal client:visible variant="up">
      <div class="contacto-card rounded-[1.75rem] px-6 py-8 sm:rounded-[2rem] sm:px-10 sm:py-12 lg:px-14 lg:py-14">
        <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-14">
          <div class="max-w-md">
            <h2
              id="contacto-heading"
              class="text-[1.55rem] font-bold leading-[1.2] tracking-tight text-brand-navy xs:text-[1.75rem] sm:text-[2rem] lg:text-[2.25rem]"
            >
              {contacto.headline}
            </h2>
            <p class="mt-4 text-[0.95rem] leading-[1.65] text-text-soft sm:mt-5 sm:text-base">
              {contacto.body}
            </p>
          </div>

          <ContactForm
            client:visible
            whatsapp={siteConfig.whatsapp}
            specialties={contacto.specialties}
            attentionTypes={contacto.attentionTypes}
            fields={contacto.fields}
            submitLabel={contacto.submit}
            validationTitle={contacto.validationTitle}
            validationBody={contacto.validationBody}
          />
        </div>
      </div>
    </MotionReveal>
  </div>
</section>

<style>
  .contacto-card {
    background: linear-gradient(90deg, #efeaf8 0%, #d9d0f0 100%);
  }
</style>
