---
import { equipos } from "@content/content";
import MotionReveal from "@components/islands/MotionReveal";

const itemVariants = ["left", "up", "right", "up"] as const;
---

<section class="equipos bg-brand-neutral-mist pb-10 pt-5 md:pb-12 md:pt-6 lg:pb-14" aria-label={equipos.headline}>
  <div class="container">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
      {
        equipos.items.map((item, index) => (
          <MotionReveal client:load variant={itemVariants[index % 4]} delay={0.04 + index * 0.06}>
            <article class="equipo-card relative isolate min-h-[18rem] overflow-hidden rounded-[1.15rem] sm:min-h-[20rem]">
              <img
                src={item.image.src}
                alt={item.image.alt}
                class="absolute inset-0 h-full w-full object-cover"
                width="480"
                height="640"
                loading="lazy"
                decoding="async"
              />
              <div
                class="absolute inset-0 bg-[linear-gradient(180deg,transparent_22%,rgba(8,16,58,0.28)_48%,rgba(6,14,52,0.78)_72%,rgba(4,10,42,0.94)_100%)]"
                aria-hidden="true"
              />
              <div class="relative z-10 flex h-full min-h-[18rem] flex-col justify-end p-5 text-white sm:min-h-[20rem] sm:p-6">
                <h3 class="font-dm text-lg font-bold leading-tight sm:text-xl">{item.title}</h3>
                <p class="mt-2 text-sm leading-[1.45] text-white/90">{item.body}</p>
              </div>
            </article>
          </MotionReveal>
        ))
      }
    </div>
  </div>
</section>
