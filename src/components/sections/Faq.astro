---
import { faq } from "@content/content";
import MotionReveal from "@components/islands/MotionReveal";
import FaqAccordion from "@components/islands/FaqAccordion";
---

<section
  id={faq.id}
  class="faq bg-brand-neutral-mist py-10 md:py-12 lg:py-14"
  aria-labelledby="faq-heading"
>
  <div class="container">
    <MotionReveal client:load variant="up" className="mx-auto max-w-3xl text-center">
      <h2
        id="faq-heading"
        class="font-serif text-[1.85rem] font-medium leading-[1.15] text-[#211E46] sm:text-[2.35rem] md:text-[2.75rem]"
      >
        {faq.headline}
      </h2>
    </MotionReveal>

    <MotionReveal client:load variant="up" delay={0.12} className="mt-8 sm:mt-10">
      <FaqAccordion client:visible items={faq.items} />
    </MotionReveal>
  </div>
</section>
