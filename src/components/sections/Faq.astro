---
import { faq } from "@content/content";
import MotionReveal from "@components/islands/MotionReveal";
import FaqAccordion from "@components/islands/FaqAccordion";
---

<section
  id={faq.id}
  class="faq bg-brand-neutral-mist py-10 md:py-12 lg:py-14"
  aria-labelledby="faq-heading"
>
  <div class="container">
    <MotionReveal client:visible variant="up" className="mx-auto max-w-3xl text-center">
      <h2
        id="faq-heading"
        class="text-[1.65rem] font-bold leading-[1.2] tracking-tight text-brand-navy xs:text-[1.85rem] sm:text-[2.05rem] md:text-[2.25rem] lg:text-[2.5rem]"
      >
        {faq.headline}
      </h2>
    </MotionReveal>

    <MotionReveal client:visible variant="up" delay={0.12} className="mt-8 sm:mt-10">
      <FaqAccordion client:visible items={faq.items} />
    </MotionReveal>
  </div>
</section>
