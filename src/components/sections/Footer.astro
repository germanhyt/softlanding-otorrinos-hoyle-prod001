---
import { siteConfig } from "@config/site.config";
import { footer, logos } from "@content/content";

const phone = siteConfig.phone;
const email = siteConfig.email;
---

<footer class="bg-[#0D1146] text-white">
  <div class="container py-12 md:py-14 lg:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-x-8">
      <div class="sm:col-span-2 lg:col-span-5">
        <a href="#inicio" class="inline-flex" aria-label="Hoyle Otorrinos — inicio">
          <img
            src={logos.white.src}
            alt={logos.white.alt}
            class="h-10 w-auto max-w-[13.5rem] object-contain object-left sm:h-11"
            width="220"
            height="42"
          />
        </a>
        <p class="mt-5 max-w-[17.5rem] font-dm text-sm leading-[1.55] text-white/75">
          {footer.tagline}
        </p>
      </div>

      <nav class="lg:col-span-4" aria-label={footer.exploreTitle}>
        <p class="font-dm text-sm font-semibold text-white/50">{footer.exploreTitle}</p>
        <ul class="mt-4 flex flex-col gap-3">
          {
            footer.explore.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="font-dm text-sm text-white/80 transition hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:col-span-3">
        <p class="font-dm text-sm font-semibold text-white/50">{footer.contactTitle}</p>
        <ul class="mt-4 flex flex-col gap-3 font-dm text-sm text-white/80">
          <li>
            {
              phone ? (
                <a href={`tel:${phone}`} class="transition hover:text-white">
                  {phone}
                </a>
              ) : (
                <span>{footer.phoneLabel}</span>
              )
            }
          </li>
          <li>
            {
              email ? (
                <a href={`mailto:${email}`} class="transition hover:text-white">
                  {email}
                </a>
              ) : (
                <span>{footer.emailLabel}</span>
              )
            }
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-white/20 pt-5 font-dm text-sm text-white/65 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>{footer.copyright}</p>
      {
        email ? (
          <a href={`mailto:${email}`} class="transition hover:text-white">
            {email}
          </a>
        ) : (
          <span>{footer.emailLabel}</span>
        )
      }
    </div>
  </div>
</footer>
