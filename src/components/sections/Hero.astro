---
import { hero } from "@content/content";
import HeroStats from "@components/islands/HeroStats";
import MotionScope from "@components/islands/MotionScope";
---

<section
  id={hero.id}
  class="hero relative z-20 overflow-visible bg-brand-navy"
  aria-labelledby="hero-heading"
>
  <div class="hero-frame relative min-h-[42.5rem] overflow-hidden md:h-[620px] md:min-h-0 lg:h-[640px] xl:h-[700px] 2xl:h-[760px] 3xl:h-[812px]">
    <div class="hero-media" aria-hidden="true">
      <picture class="hero-media__picture">
        <source media="(min-width: 768px)" srcset={hero.image.src} />
        <img src={hero.imageMobile.src} alt="" class="hero-media__photo" />
      </picture>
    </div>

    <div class="hero-shade-mobile absolute inset-0 z-[1] md:hidden" aria-hidden="true"></div>
    <div
      class="hero-shade-desktop absolute inset-0 z-[1] hidden md:block"
      aria-hidden="true"
    >
    </div>

    <div
      class="container relative z-10 flex min-h-[42.5rem] flex-col justify-start pb-[14.5rem] pt-28 md:h-full md:min-h-0 md:justify-center md:pb-32 md:pt-24"
    >
      <MotionScope
        client:load
        trigger="mount"
        variant="up"
        staggerDelay={0.16}
        className="max-w-[20rem] font-dm text-white xs:max-w-[22rem] sm:max-w-md md:max-w-[529px]"
      >
        <h1
          id="hero-heading"
          data-motion-item
          class="max-w-[517px] font-serif text-[1.85rem] font-semibold leading-[1.2] text-white sm:text-[2.4rem] md:text-[3rem] md:leading-[60px]"
        >
          {hero.headline}
        </h1>
        <p
          data-motion-item
          class="mt-3 max-w-[529px] text-[0.95rem] font-normal leading-[1.4] text-white sm:text-base md:mt-[12px] md:text-[18px] md:leading-[25px]"
        >
          {hero.body}
        </p>
        <div data-motion-item>
          <a
            href={hero.cta.href}
            class="mt-5 inline-flex min-w-[11.75rem] items-center justify-center rounded-[20px] bg-[#7C63C9] px-2.5 py-2.5 text-base font-semibold text-white transition hover:bg-[#6d54b8] md:mt-[19px] md:text-[20px] md:leading-[25px]"
          >
            {hero.cta.label}
          </a>
        </div>
      </MotionScope>
    </div>
  </div>

  <HeroStats client:load stats={hero.stats} />
</section>

<style>
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    animation: hero-media-in 1.25s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes hero-media-in {
    from {
      opacity: 0.35;
      transform: scale(1.07);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-media {
      animation: none;
    }
  }

  .hero-media__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-media__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }

  @media (max-width: 767px) {
    .hero-media__photo {
      object-position: 72% 70%;
    }
  }

  @media (min-width: 768px) {
    .hero-media__photo {
      object-position: 72% 40%;
      transform: scale(1.04);
      transform-origin: 72% 40%;
    }
  }

  .hero-shade-mobile {
    background: linear-gradient(
      180deg,
      rgba(13, 17, 70, 0.78) 0%,
      rgba(20, 18, 80, 0.62) 32%,
      rgba(30, 28, 100, 0.38) 58%,
      rgba(30, 28, 100, 0.18) 78%,
      transparent 100%
    );
  }

  .hero-shade-desktop {
    background: linear-gradient(
      90deg,
      rgba(33, 30, 70, 0.74) 5%,
      rgba(38, 35, 82, 0.64) 22%,
      rgba(42, 39, 90, 0.54) 34%,
      rgba(102, 102, 102, 0.05) 66%
    );
  }
</style>
