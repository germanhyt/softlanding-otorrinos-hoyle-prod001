---
import { hero } from "@content/content";
import HeroStats from "@components/islands/HeroStats";
import MotionScope from "@components/islands/MotionScope";
---

<section
  id={hero.id}
  class="hero relative z-20 overflow-visible bg-brand-navy"
  aria-labelledby="hero-heading"
>
  <div class="hero-frame relative min-h-[100svh] overflow-hidden">
    <div class="hero-media" aria-hidden="true">
      <picture class="hero-media__picture">
        <source media="(min-width: 768px)" srcset={hero.image.src} />
        <img src={hero.imageMobile.src} alt="" class="hero-media__photo" />
      </picture>
    </div>

    <div class="hero-shade-mobile absolute inset-0 z-[1] md:hidden" aria-hidden="true"></div>
    <div
      class="hero-shade-desktop absolute inset-0 z-[1] hidden md:block"
      aria-hidden="true"
    >
    </div>

    <div
      class="container relative z-10 flex min-h-[100svh] flex-col justify-center pb-40 pt-24 sm:pb-44 md:pb-48 lg:pb-52"
    >
      <MotionScope
        client:load
        trigger="mount"
        variant="up"
        staggerDelay={0.16}
        className="max-w-[20rem] text-white xs:max-w-[22rem] sm:max-w-md md:max-w-[36rem] lg:max-w-[42rem]"
      >
        <h1
          id="hero-heading"
          data-motion-item
          class="text-[1.7rem] font-bold leading-[1.12] tracking-tight text-white xs:text-[1.9rem] sm:text-[2.2rem] md:text-[2.55rem] lg:text-[2.85rem]"
        >
          {hero.headline}
        </h1>
        <p
          data-motion-item
          class="mt-4 text-[1.05rem] font-medium leading-[1.55] text-white/92 xs:text-[1.15rem] sm:mt-5 sm:text-[1.25rem] md:text-[1.35rem] md:leading-[1.5] lg:text-[1.45rem]"
        >
          {hero.body}
        </p>
        <div data-motion-item>
          <a
            href={hero.cta.href}
            class="mt-7 inline-flex items-center rounded-full bg-brand-blue px-7 py-3 text-[0.95rem] font-bold text-white transition hover:bg-brand-blue-hover sm:mt-8 sm:px-8 sm:py-3.5"
          >
            {hero.cta.label}
          </a>
        </div>
      </MotionScope>
    </div>
  </div>

  <HeroStats client:load stats={hero.stats} />
</section>

<style>
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    animation: hero-media-in 1.25s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes hero-media-in {
    from {
      opacity: 0.35;
      transform: scale(1.07);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-media {
      animation: none;
    }
  }

  .hero-media__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-media__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }

  @media (max-width: 767px) {
    .hero-media__photo {
      object-position: 58% 42%;
    }
  }

  @media (min-width: 768px) {
    .hero-media__photo {
      object-position: 72% 40%;
      transform: scale(1.04);
      transform-origin: 72% 40%;
    }
  }

  .hero-shade-mobile {
    background: linear-gradient(
      180deg,
      rgba(13, 17, 70, 0.78) 0%,
      rgba(20, 18, 80, 0.62) 32%,
      rgba(30, 28, 100, 0.38) 58%,
      rgba(30, 28, 100, 0.18) 78%,
      transparent 100%
    );
  }

  .hero-shade-desktop {
    background: linear-gradient(
      90deg,
      rgba(13, 17, 70, 0.94) 0%,
      rgba(22, 20, 86, 0.82) 22%,
      rgba(46, 42, 110, 0.52) 44%,
      rgba(46, 42, 110, 0.18) 66%,
      transparent 86%
    );
  }
</style>
