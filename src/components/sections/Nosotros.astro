---
import { nosotros } from "@content/content";
import MotionReveal from "@components/islands/MotionReveal";
---

<section
  id={nosotros.id}
  class="nosotros relative z-0 bg-brand-neutral-fog"
  aria-labelledby="nosotros-heading"
>
  <div
    class="container grid items-center gap-10 pb-10 md:grid-cols-2 md:gap-12 md:pb-12 lg:gap-16 lg:pb-14 xl:gap-20"
  >
    <MotionReveal client:visible variant="left" className="max-w-[36rem]">
      <h2
        id="nosotros-heading"
        class="max-w-[589px] font-serif text-[1.85rem] font-semibold leading-[1.2] text-[#211E46] sm:text-[2.35rem] md:text-[3rem] md:leading-[60px]"
      >
        {nosotros.headline}
      </h2>
      {
        nosotros.paragraphs.map((paragraph) => (
          <p class="mt-5 max-w-[36rem] font-dm text-[0.95rem] font-normal leading-[1.45] text-[#050139] sm:text-base md:mt-6 md:text-[18px] md:leading-[25px]">
            {paragraph}
          </p>
        ))
      }
    </MotionReveal>

    <MotionReveal client:visible variant="scale" delay={0.1}>
      <div class="nosotros-photo overflow-hidden rounded-[1.25rem]">
        <img
          src={nosotros.image.src}
          alt={nosotros.image.alt}
          class="aspect-[16/11] h-full w-full object-cover object-center md:aspect-auto md:min-h-[20rem] lg:min-h-[24rem]"
          width="1424"
          height="811"
          loading="lazy"
          decoding="async"
        />
      </div>
    </MotionReveal>
  </div>
</section>

<style>
  .nosotros-photo {
    box-shadow: 0 18px 40px rgb(13 17 70 / 0.12);
  }
</style>
