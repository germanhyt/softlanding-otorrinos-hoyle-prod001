---
import { septorrinoplastia } from "@content/content";
import SeptorrinoplastiaPin from "@components/islands/SeptorrinoplastiaPin";
---

<section id={septorrinoplastia.id} class="septorrinoplastia" aria-label={septorrinoplastia.detail.title}>
  <SeptorrinoplastiaPin
    client:load
    image={septorrinoplastia.image}
    pair={septorrinoplastia.pair}
    detail={septorrinoplastia.detail}
  />
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .septorrinoplastia :global([data-detail]) {
      position: relative;
      inset: auto;
      opacity: 1;
      padding-bottom: 4rem;
    }

    .septorrinoplastia :global([data-scene]) {
      height: auto;
    }

    .septorrinoplastia :global([data-sticky]) {
      position: relative;
      top: auto;
      height: auto;
      min-height: 100svh;
    }
  }
</style>

<script>
  const scene = document.querySelector<HTMLElement>("[data-scene]");

  if (scene && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    // El táctil fluye nativo: interceptar cada touchmove mata el impulso
    // y obliga a varios gestos. Solo la rueda lleva paso guiado.
    const maxStep = 32;
    const lead = 58;
    const ease = 0.12;
    const factor = 0.26;
    let target = window.scrollY;
    let lastWritten = window.scrollY;
    let easing = false;
    let frame = 0;

    const bounds = () => {
      const top = scene.getBoundingClientRect().top + window.scrollY;
      const bottom = top + scene.offsetHeight - window.innerHeight;
      return { top, bottom };
    };

    const tick = () => {
      const current = window.scrollY;
      if (Math.abs(current - lastWritten) > lead + 40) {
        target = current;
        lastWritten = current;
        easing = false;
        frame = 0;
        return;
      }
      const delta = target - current;
      if (Math.abs(delta) < 0.5) {
        window.scrollTo(0, target);
        lastWritten = target;
        easing = false;
        frame = 0;
        return;
      }
      const next = current + delta * ease;
      window.scrollTo(0, next);
      lastWritten = next;
      frame = requestAnimationFrame(tick);
    };

    const nudge = (deltaY: number) => {
      const { top, bottom } = bounds();
      const current = easing ? target : window.scrollY;
      const next = current + deltaY;
      const hits =
        (current < top && next > top) ||
        (current > bottom && next < bottom) ||
        (current >= top && current <= bottom);
      if (!hits) return false;

      const step = Math.sign(deltaY) * Math.min(Math.abs(deltaY) * factor, maxStep);
      const visual = window.scrollY;
      lastWritten = visual;
      let proposed = current + step;
      if (current < top && deltaY > 0) proposed = Math.max(top, proposed);
      if (current > bottom && deltaY < 0) proposed = Math.min(bottom, proposed);
      proposed = Math.min(Math.max(proposed, visual - lead), visual + lead);
      target = proposed;
      easing = true;
      if (!frame) frame = requestAnimationFrame(tick);
      return true;
    };

    window.addEventListener(
      "wheel",
      (event) => {
        if (nudge(event.deltaY)) event.preventDefault();
      },
      { passive: false },
    );

  }
</script>
