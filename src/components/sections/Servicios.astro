---
import { servicios } from "@content/content";
import MotionReveal from "@components/islands/MotionReveal";
---

<section
  id={servicios.id}
  class="servicios bg-brand-lavender py-10 md:py-12 lg:py-14"
  aria-labelledby="servicios-heading"
>
  <div class="container">
    <MotionReveal client:visible variant="up" className="mx-auto max-w-3xl text-center">
      <h2
        id="servicios-heading"
        class="text-[1.65rem] font-bold leading-[1.2] tracking-tight text-brand-navy xs:text-[1.85rem] sm:text-[2.05rem] md:text-[2.25rem] lg:text-[2.5rem]"
      >
        {servicios.headline}
      </h2>
      <p
        class="mx-auto mt-4 max-w-2xl text-[0.95rem] leading-[1.65] text-text-muted sm:text-base md:mt-5 md:text-[1.05rem]"
      >
        {servicios.intro}
      </p>
    </MotionReveal>

    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 lg:mt-10 lg:grid-cols-3 lg:gap-6">
      {
        servicios.cards.map((card, index) => (
          <MotionReveal client:visible variant="up" delay={0.04 + index * 0.09}>
            <article class="servicios-card relative isolate min-h-[11.5rem] overflow-hidden rounded-[1.25rem] bg-white px-6 py-6 sm:min-h-[12.5rem] sm:px-7 sm:py-7 lg:min-h-[13.5rem]">
              <h3 class="servicios-card__copy relative z-10 text-xl font-bold tracking-tight text-brand-navy sm:text-[1.35rem]">
                {card.title}
              </h3>
              <p class="servicios-card__copy relative z-10 mt-3 text-sm leading-[1.55] text-text-muted sm:text-[0.95rem]">
                {card.body}
              </p>
              <img
                src={card.icon}
                alt=""
                class="servicios-card__icon pointer-events-none absolute bottom-0 right-0 h-[7.5rem] w-[7.5rem] object-contain sm:h-[8.25rem] sm:w-[8.25rem]"
                width="160"
                height="160"
                loading="lazy"
                decoding="async"
                aria-hidden="true"
              />
            </article>
          </MotionReveal>
        ))
      }
    </div>
  </div>
</section>

<style>
  .servicios-card {
    box-shadow: 0 10px 28px rgb(13 17 70 / 0.06);
  }

  .servicios-card__copy {
    max-width: calc(100% - 5.75rem);
  }

  .servicios-card__icon {
    transform: translate(28%, 22%);
  }
</style>
