---
import { servicios } from "@content/content";
import MotionReveal from "@components/islands/MotionReveal";

const cardVariants = ["left", "up", "right"] as const;
---

<section
  id={servicios.id}
  class="servicios bg-brand-navy py-12 md:py-14 lg:py-16"
  aria-labelledby="servicios-heading"
>
  <div data-servicios-scene>
  <div class="container">
    <div class="grid items-end gap-5 md:grid-cols-[minmax(0,1.05fr)_minmax(0,0.9fr)] md:gap-10 lg:gap-16">
      <MotionReveal client:load variant="left">
        <h2
          id="servicios-heading"
          class="max-w-[26rem] font-serif text-[1.85rem] font-semibold leading-[1.15] text-white sm:max-w-[32rem] sm:text-[2.35rem] md:max-w-[36rem] md:text-[2.6rem] md:leading-[55px] lg:text-[3rem]"
        >
          {servicios.headline}
        </h2>
      </MotionReveal>
      <MotionReveal client:load variant="right" delay={0.08}>
        <p class="max-w-[34rem] font-dm text-[0.95rem] font-normal leading-[1.45] text-white md:text-[18px] md:leading-[25px]">
          {servicios.intro}
        </p>
      </MotionReveal>
    </div>

    <div data-servicios-viewport class="servicios-viewport mt-6 overflow-x-clip md:mt-8 md:overflow-hidden">
      <div data-servicios-track class="servicios-track flex w-full flex-col gap-4 md:w-max md:flex-row md:gap-5">
      {
        servicios.cards.map((card, index) => (
          <MotionReveal
            client:load
            mobileOnly
            variant={cardVariants[index % 3]}
            delay={0.04 + index * 0.08}
            className="w-full md:contents"
          >
            <article class="servicios-card relative isolate min-h-[12.5rem] shrink-0 overflow-hidden rounded-[1.25rem] bg-white px-6 py-6 sm:min-h-[13.5rem] sm:px-7 sm:py-7">
              <h3 class="servicios-card__copy relative z-10 font-dm text-xl font-bold tracking-tight text-brand-navy sm:text-[1.35rem]">
                {card.title}
              </h3>
              <p class="servicios-card__copy relative z-10 mt-3 font-dm text-base leading-[1.5] text-[#3d4268] sm:text-[1.05rem]">
                {card.body}
              </p>
              <img
                src={card.icon}
                alt=""
                class="servicios-card__icon pointer-events-none absolute bottom-0 right-0 h-[7.25rem] w-[7.25rem] object-contain sm:h-[8rem] sm:w-[8rem]"
                width="160"
                height="160"
                loading="lazy"
                decoding="async"
                aria-hidden="true"
              />
            </article>
          </MotionReveal>
        ))
      }
      </div>
    </div>
  </div>
  </div>
</section>

<style>
  .servicios-viewport {
    container-type: inline-size;
  }

  .servicios-track {
    padding-bottom: 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .servicios [data-servicios-viewport] {
      overflow-x: auto;
    }
  }

  .servicios-track::-webkit-scrollbar {
    display: none;
  }

  .servicios-card {
    flex: 0 0 auto;
    width: 100%;
    box-shadow: 0 10px 28px rgb(0 0 0 / 0.12);
  }

  @media (min-width: 768px) {
    .servicios-card {
      flex: 0 0 calc((100cqi - 1.25rem) / 2);
      width: calc((100cqi - 1.25rem) / 2);
      scroll-snap-align: start;
    }
  }

  @media (min-width: 1024px) {
    .servicios-card {
      flex-basis: calc((100cqi - 2.5rem) / 3);
      width: calc((100cqi - 2.5rem) / 3);
    }
  }

  .servicios-card__copy {
    max-width: calc(100% - 4.5rem);
  }

  .servicios-card__icon {
    transform: translate(18%, 16%);
  }
</style>

<script>
  import gsap from "gsap";
  import { holdScroll, releaseScroll } from "@lib/lenis";

  const section = document.querySelector<HTMLElement>(".servicios");
  const viewport = document.querySelector<HTMLElement>("[data-servicios-viewport]");
  const track = document.querySelector<HTMLElement>("[data-servicios-track]");

  if (section && viewport && track && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const motion = { x: 0 };
    let offset = 0;
    let target = 0;
    let wheelAccum = 0;
    let lockUntil = 0;
    let lastWritten = window.scrollY;
    let holding = false;

    const travel = () => Math.max(0, track.scrollWidth - viewport.clientWidth);
    const sectionTop = () => section.getBoundingClientRect().top + window.scrollY;
    const lockY = () => Math.max(0, sectionTop() + section.offsetHeight - window.innerHeight);
    const done = () => offset >= travel() - 1.5 && target >= travel() - 1.5;
    const atStart = () => offset <= 1.5 && target <= 1.5;
    const isMobile = () => window.matchMedia("(max-width: 767px)").matches;
    const mobileQuery = window.matchMedia("(max-width: 767px)");

    const stepSize = () => {
      const card = track.querySelector<HTMLElement>(".servicios-card");
      if (!card) return 0;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card.getBoundingClientRect().width + gap;
    };

    const clampStep = (value: number) => {
      const span = travel();
      const step = stepSize();
      if (step <= 0) return Math.min(span, Math.max(0, value));
      const snapped = Math.round(value / step) * step;
      if (span - snapped < step * 0.35) return span;
      return Math.min(span, Math.max(0, snapped));
    };

    const glide = (next: number) => {
      const seconds = isMobile() ? 0.92 : 1.08;
      lockUntil = performance.now() + seconds * 1000 + 140;
      target = next;
      gsap.killTweensOf(motion);
      gsap.to(motion, {
        x: next,
        duration: seconds,
        ease: "power2.inOut",
        onUpdate: () => {
          offset = motion.x;
          gsap.set(track, { x: -offset });
        },
        onComplete: () => {
          offset = next;
          motion.x = next;
          gsap.set(track, { x: -offset });
          wheelAccum = 0;
        },
      });
    };

    const stepBy = (dir: number) => {
      const step = stepSize();
      const span = travel();
      if (step <= 0 || dir === 0 || span <= 0) return false;
      const current = target;
      let next = clampStep(current + dir * step);
      if (dir > 0 && span - current <= step * 0.35) next = span;
      if (dir < 0 && current <= step * 0.35) next = 0;
      if (Math.abs(next - current) < 1) return false;
      glide(next);
      return true;
    };

    const advance = (deltaY: number) => {
      if (performance.now() < lockUntil) return;
      wheelAccum += deltaY;
      const need = isMobile() ? 42 : 72;
      if (Math.abs(wheelAccum) < need) return;
      const dir = Math.sign(wheelAccum);
      wheelAccum = 0;
      stepBy(dir);
    };

    const reset = () => {
      gsap.killTweensOf(motion);
      offset = 0;
      target = 0;
      motion.x = 0;
      wheelAccum = 0;
      lockUntil = 0;
      gsap.set(track, { x: 0 });
    };

    const nudge = (deltaY: number) => {
      if (isMobile()) return false;
      const span = travel();
      if (span <= 0 || deltaY === 0) return false;

      if (document.documentElement.dataset.programmaticScroll === "1") return false;

      const y = window.scrollY;
      const lock = lockY();
      const approaching = deltaY > 0 && !done() && y < lock && y + Math.min(Math.abs(deltaY), 180) >= lock;
      const holdingDown = deltaY > 0 && !done() && y >= lock - 2 && y <= lock + 72;
      const holdingUp = deltaY < 0 && !atStart() && y >= lock - 2 && y <= lock + 72;
      if (approaching || holdingDown || holdingUp) {
        holding = true;
        holdScroll(lock);
        lastWritten = lock;
        holding = false;
        advance(deltaY);
        return true;
      }

      const leavingDown = deltaY > 0 && done() && y >= lock - 2;
      const leavingUp = deltaY < 0 && atStart() && y >= lock - 2 && y <= lock + 72;
      if (leavingDown || leavingUp) releaseScroll();

      return false;
    };

    window.addEventListener(
      "wheel",
      (event) => {
        if (!nudge(event.deltaY)) return;
        event.preventDefault();
        event.stopPropagation();
      },
      { passive: false, capture: true },
    );

    let touchY = 0;
    window.addEventListener(
      "touchstart",
      (event) => {
        touchY = event.touches[0]?.clientY ?? 0;
      },
      { passive: true },
    );
    window.addEventListener(
      "touchmove",
      (event) => {
        const y = event.touches[0]?.clientY ?? touchY;
        const delta = touchY - y;
        touchY = y;
        if (!nudge(delta)) return;
        event.preventDefault();
        event.stopPropagation();
      },
      { passive: false, capture: true },
    );

    window.addEventListener("keydown", (event) => {
      const down = event.key === "ArrowDown" || event.key === "PageDown" || event.key === " ";
      const up = event.key === "ArrowUp" || event.key === "PageUp";
      if (!down && !up) return;
      if (event.target instanceof HTMLElement && event.target.closest("input, textarea, select")) return;
      const delta = down ? (event.key === "ArrowDown" ? 48 : 520) : event.key === "ArrowUp" ? -48 : -520;
      if (nudge(delta)) event.preventDefault();
    });

    window.addEventListener(
      "scroll",
      () => {
        if (isMobile()) {
          releaseScroll();
          lastWritten = window.scrollY;
          return;
        }
        if (holding || document.documentElement.dataset.programmaticScroll === "1") {
          lastWritten = window.scrollY;
          return;
        }
        const y = window.scrollY;
        if (y + window.innerHeight < sectionTop() - 24) {
          if (!atStart()) reset();
          releaseScroll();
          lastWritten = y;
          return;
        }
        const lock = lockY();
        const overshoot = y - lock;
        if (done() && overshoot > 80) releaseScroll();
        if (!done() && overshoot > 1 && overshoot < 140 && Math.abs(y - lastWritten) < 160) {
          holding = true;
          holdScroll(lock);
          lastWritten = lock;
          holding = false;
          return;
        }
        lastWritten = y;
      },
      { passive: true },
    );

    const freeMobile = () => {
      if (!isMobile()) return;
      reset();
      releaseScroll();
    };
    freeMobile();
    mobileQuery.addEventListener("change", freeMobile);

    window.addEventListener("resize", () => {
      gsap.killTweensOf(motion);
      if (isMobile()) {
        reset();
        releaseScroll();
        return;
      }
      const span = travel();
      offset = clampStep(Math.min(offset, span));
      target = offset;
      motion.x = offset;
      wheelAccum = 0;
      lockUntil = 0;
      gsap.set(track, { x: -offset });
    });
  }
</script>
