---
import { tecnologia } from "@content/content";
import MotionReveal from "@components/islands/MotionReveal";
---

<section
  id={tecnologia.id}
  class="tecnologia bg-brand-neutral-mist pt-10 md:pt-12 lg:pt-14"
  aria-labelledby="tecnologia-heading"
>
  <div class="container">
    <MotionReveal client:visible variant="up" className="max-w-3xl">
      <h2
        id="tecnologia-heading"
        class="max-w-[20rem] font-serif text-[1.85rem] font-semibold leading-[1.15] text-[#211E46] sm:max-w-2xl sm:text-[2.35rem] md:text-[2.75rem] md:leading-[1.12] lg:text-[3rem]"
      >
        {tecnologia.headline}
      </h2>
      <p class="mt-4 max-w-xl font-dm text-[0.95rem] leading-[1.5] text-[#3d4268] sm:text-base">
        {tecnologia.body}
      </p>
    </MotionReveal>

    <MotionReveal client:visible variant="scale" delay={0.08} className="mt-8 sm:mt-10">
      <figure class="tecnologia-photo relative overflow-hidden rounded-[1.25rem] sm:rounded-[1.5rem]">
        <img
          src={tecnologia.image.src}
          alt={tecnologia.image.alt}
          class="aspect-[16/9] w-full object-cover sm:aspect-[16/8]"
          width="1440"
          height="720"
          loading="lazy"
          decoding="async"
        />
        <div
          class="absolute inset-0 bg-[linear-gradient(180deg,transparent_42%,rgba(18,28,72,0.28)_68%,rgba(16,24,64,0.72)_100%)]"
          aria-hidden="true"
        >
        </div>
        <figcaption class="absolute inset-x-0 bottom-0 px-6 pb-6 text-center font-dm text-base font-medium text-white sm:pb-8 sm:text-lg md:text-xl">
          {tecnologia.caption}
        </figcaption>
      </figure>
    </MotionReveal>
  </div>
</section>
