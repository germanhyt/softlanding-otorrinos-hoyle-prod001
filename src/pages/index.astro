---
import Layout from "../layouts/Layout.astro";
import Header from "@components/sections/Header.astro";
import Hero from "@components/sections/Hero.astro";
import Nosotros from "@components/sections/Nosotros.astro";
import Servicios from "@components/sections/Servicios.astro";
import Alcance from "@components/sections/Alcance.astro";
import Tecnologia from "@components/sections/Tecnologia.astro";
import Equipos from "@components/sections/Equipos.astro";
import Atencion from "@components/sections/Atencion.astro";
import Congresos from "@components/sections/Congresos.astro";
import Contacto from "@components/sections/Contacto.astro";
import Articulos from "@components/sections/Articulos.astro";
import Faq from "@components/sections/Faq.astro";
import Footer from "@components/sections/Footer.astro";
---

<Layout>
  <Header />
  <main id="main" class="clip-main-mobile flex-1 overflow-x-clip">
    <Hero />
    <Nosotros />
    <Servicios />
    <Alcance />
    <Tecnologia />
    <Equipos />
    <Atencion />
    <Congresos />
    <Contacto />
    <Articulos />
    <Faq />
  </main>
  <Footer />
</Layout>
